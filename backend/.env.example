# =====================================================================
#  ReliefPay configuration. Copy this file to ".env" and fill it in.
#  NEVER commit .env to GitHub (it's already in .gitignore).
# =====================================================================

# ---- Staff accounts (created automatically on startup) ----
# Change these passwords before you deploy anywhere public.
# admin    = can approve/reject AND send money (payouts)
# reviewer = can approve/reject, cannot send money
ADMIN_EMAIL=admin@reliefpay.org
ADMIN_PASSWORD=Admin#2026demo
ADMIN_NAME=Maria Santos
REVIEWER_EMAIL=reviewer@reliefpay.org
REVIEWER_PASSWORD=Review#2026demo
REVIEWER_NAME=Arjun Mehta

# ---- Security ----
# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=8
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# ---- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID (developer.paypal.com > your app > Add Webhook). Only works when the app is online (hosted).
PAYPAL_WEBHOOK_ID=
# Let US families receive aid on Venmo (phone number)
ENABLE_VENMO=true
# Monthly donation tiers in USD (PayPal Subscriptions)
MONTHLY_TIERS_USD=10,25,50

# ---- AI ----
# gemini    = free key from https://aistudio.google.com  (recommended)
# claude    = key from https://platform.claude.com (paid, separate from Claude Pro)
# heuristic = no AI key, uses transparent keyword rules (works offline)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# If the main model hits its free limit (429) these are tried next
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# ---- Donations in rupees ----
# PayPal only lets India-registered accounts receive INR, so donors choose rupees and PayPal
# charges the USD equivalent. Update this rate now and then.
INR_PER_USD=96

# ---- Disaster check: "did the flood they describe really happen?" ----
# Never rejects anyone; "not confirmed" is a warning for staff before paying.
# Sources: campaign zones below, GDACS (UN/EU), NASA EONET, and AI web search (uses your AI quota).
DISASTER_CHECK=true
DISASTER_WEB_SEARCH=true
DISASTER_LOOKBACK_DAYS=30
DISASTER_RADIUS_KM=150
# Your active relief areas (JSON). Anyone applying from inside one counts as confirmed.
DISASTER_ZONES=[{"name":"Eastern Samar typhoon","event":"typhoon","lat":11.25,"lng":125.45,"radius_km":120}]

# ---- "Try it as a judge" button (one-click reviewer login, can't send money) ----
JUDGE_DEMO_LOGIN=false

# ---- Campaign + safety limits ----
CAMPAIGN_NAME=Typhoon Relief - Eastern Samar
CAMPAIGN_GOAL_USD=10000
MAX_DONATION_USD=10000
MAX_PAYOUT_PER_FAMILY_USD=500
MAX_BATCH_TOTAL_USD=5000

# ---- Demo data ----
# Seeds 12 realistic applications (incl. 3 fraud cases), 20 donations and one payout batch
SEED_DEMO_DATA=true
# Optional: comma-separated sandbox PERSONAL account emails. Seeded families will use them,
# so real sandbox payouts show "Success" instead of "Unclaimed".
SANDBOX_RECIPIENT_EMAILS=

# ---- Local development (ignored in Docker) ----
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
